# ==============================================================================
# El Dugout Ve - Environment Configuration
# Copy this file to .env and adjust values for your environment
# ==============================================================================

# --- Node & Application Settings ---
NODE_ENV=development
PORT=3000
APP_NAME="El Dugout Ve"
API_PREFIX="api"
CORS_ORIGINS="http://localhost:4200,http://localhost:8080,https://eldugoutve.com,https://www.eldugoutve.com"

# --- Security & Auth ---
JWT_SECRET=supersecret-replace-with-secure-random-value-in-production
JWT_EXPIRATION=7d

# --- Database (PostgreSQL / Google Cloud SQL) ---
# Local Docker Postgres connection:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=el_dugout_ve
POSTGRES_PORT=5435
POSTGRES_HOST=localhost

# Standard local connection URL used by Prisma:
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# --- Google Cloud Platform Deployment Settings ---
# For GCP Cloud Run + Cloud SQL:
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ARTIFACT_REPO=el-dugout-repo
CLOUD_SQL_INSTANCE_NAME=el-dugout-postgres
# Cloud SQL Connection Name format: PROJECT_ID:REGION:INSTANCE_NAME
CLOUD_SQL_CONNECTION_NAME=your-gcp-project-id:us-central1:el-dugout-postgres

# Cloud Run / Cloud SQL Unix Socket connection string:
# DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost/${POSTGRES_DB}?host=/cloudsql/${CLOUD_SQL_CONNECTION_NAME}"
