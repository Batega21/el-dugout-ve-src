{
  "name": "el-dugout-ve-frontend",
  "version": "1.0.0",
  "description": "El Dugout Ve - Frontend Angular application for Venezuelan Professional Baseball Wiki",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run --globals",
    "test:ng": "ng test --watch=false",
    "test:unit": "vitest run --globals"
  },
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@types/jasmine": "~5.1.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.5.0",
    "jsdom": "^30.0.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "6.0.3",
    "vitest": "^4.0.8"
