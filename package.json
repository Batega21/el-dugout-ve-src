{
  "name": "el-dugout-ve",
  "version": "1.0.0",
  "description": "El Dugout Ve - Fullstack Web Application (Wiki del Béisbol Profesional Venezolano) built with Angular, NestJS, PostgreSQL and Google Cloud",
  "private": true,
  "scripts": {
    "docker:db": "docker compose up -d postgres adminer",
    "docker:db:down": "docker compose down",
    "docker:fullstack": "docker compose --profile fullstack up --build",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run start",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:all": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm --prefix backend run test",
    "test:frontend": "npm --prefix frontend run test",
    "test:all": "npm run test:backend && npm run test:frontend",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "prisma:studio": "npm --prefix backend run prisma:studio",
    "prisma:seed": "npm --prefix backend run prisma:seed"
  },
  "keywords": [
    "angular",
    "nestjs",
    "postgresql",
    "google-cloud",
    "cloud-run",
    "cloud-sql",
    "prisma"
  ],
  "author": "",
  "license": "MIT"
}
